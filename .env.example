# ACHARYA Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
MONGODB_URL=<your-mongodb-uri>

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here

# Security
# Required in production. If empty, the app uses a random secret per process and logins reset on restart.
JWT_SECRET_KEY=

# Demo accounts (optional, off by default). SEED_DEMO_USERS=1 creates admin, recruiter1 and candidate1
# on an empty database, with these passwords or, if empty, random ones printed once to the server log.
SEED_DEMO_USERS=0
DEMO_ADMIN_PASSWORD=
DEMO_RECRUITER_PASSWORD=
DEMO_CANDIDATE_PASSWORD=

# Server Configuration (optional)
HOST=0.0.0.0
PORT=8000

# How to get these values:
# 1. MONGODB_URL: Create account at mongodb.com and get connection string
# 2. GEMINI_API_KEY: Get from https://makersuite.google.com/app/apikey
# 3. JWT_SECRET_KEY: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
